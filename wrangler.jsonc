{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ineedconvert",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "preview_urls": true,
  // Applied on the next deployment after the Cloudflare zone becomes active.
  "routes": [
    {
      "pattern": "ineedconvert.com/*",
      "zone_name": "ineedconvert.com"
    },
    {
      "pattern": "www.ineedconvert.com/*",
      "zone_name": "ineedconvert.com"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/index.html",
      "/artikel",
      "/artikel/*",
      "/kebijakan-privasi/*",
      "/syarat-ketentuan/*",
      "/api/*"
    ]
  }
}
